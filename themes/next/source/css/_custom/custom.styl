// Custom styles.
$custom-main-color = #657A81
$custom-bg-color = #fdf6e3  // solarized light
$black-light = #333
$menu-item-color = #ECE7D5  // 初始的暖沙色，hover / 激活态统一用它
$code-inline-bg = #F6EFDC  // 行内码底：Solarized base3(#fdf6e3) 与 base2(#eee8d5) 的中点，比暖沙浅一半
$timeline-tint = alpha($custom-main-color, 0.22)

.content-wrap {
  background: none;
}

.main {
  background: $custom-main-color;
}

.header-inner, .footer, .comments, .pagination {
  background: $custom-bg-color;
}

// 正文卡片：收紧四边留白，同时透出底层主色，与 footer 拉开层次
.post-block {
  background: $custom-bg-color;
  padding: 28px 32px;
  margin-bottom: 20px;
}

.menu-item-active a {
  background: $menu-item-color !important;
  color: $custom-main-color;
  border-bottom-color: transparent !important;

  &:after { background-color: $custom-main-color; }
}

.sub-menu .menu-item-active a {
  background: $menu-item-color !important;
  color: $custom-main-color;
  border-bottom-color: transparent !important;
}

body {
  background: $custom-bg-color;
  font-size: 15px;
  line-height: 1.7;

  +desktop-large() { font-size: 15px; }
}

kbd {
  background: $menu-item-color;
  border-color: alpha($custom-main-color, 0.25);
}

// 行内码底：不再复用 $menu-item-color——那是 hover / 按钮的语义，且它等于 Solarized base2，
// 压在 base3 页面底上落差偏大、看着发脏。改用两者中点，保留暖沙调、深度减半。
// 文字色覆盖主题带来的中性灰 #555（灰字配暖底是游离在体系外的组合），换成 Solarized base01。
// 只影响行内码：<pre><code> 由主题的 pre code 规则（0-0-2）单独控制，颜色仍是主色。
code {
  background: $code-inline-bg;
  color: #586e75;
}

// 1. 菜单 hover / 激活态：暖沙底 + 主色文字，压掉主题默认的白底白线
.menu .menu-item a:hover,
.menu .menu-item span.exturl:hover {
  background: $menu-item-color;
  color: $custom-main-color;
  border-bottom-color: transparent;

  &:after { background-color: $custom-main-color; }
}

// 2. 「阅读全文」按钮：浅色描边 + 主色文字，hover 反转为主色实底白字
a.post-button .btn,
.post-button .btn {
  color: $custom-main-color;
  background: alpha($custom-main-color, 0.06);
  border-color: $custom-main-color;
  border-radius: 3px;
  padding: 0 18px;

  &:hover {
    color: #fff;
    background: $custom-main-color;
    border-color: $custom-main-color;
  }
}

// 3. RSS：居中、无分隔线，与下方社交链接紧凑衔接
.feed-link {
  border-top: none;
  border-bottom: none;
  text-align: center;
  margin: 4px 0 0;
}

.feed-link a {
  display: inline-block;
  padding: 0 14px;
  color: $grey-dim;
  border: 1px solid $gainsboro;
  border-radius: 4px;

  i { color: $grey-dim; }

  &:hover {
    color: #fff;
    background: $custom-main-color;
    border-color: $custom-main-color;

    i { color: #fff; }
  }
}

// 4. 社交链接（GitHub/CSDN 等）：列内居中，hover 用暖沙晕替代白灰块
.links-of-author {
  margin-top: 8px;
}

.links-of-author-item {
  text-align: center;

  a, span.exturl {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
  }

  a:hover, span.exturl:hover {
    background: $menu-item-color;
    color: $custom-main-color;
  }
}

// 7. 侧栏底色：.sidebar-inner 的白底必须一起压掉，否则名片区会发灰白
// 底部留出间隔，避免名片与 footer 贴在一起
.sidebar {
  background: $custom-bg-color;
  margin-bottom: 20px;
}

.sidebar-inner {
  background: $custom-bg-color;
}

// 5. 版式密度：卡片、标题与段的间距整体收紧（选择器需与主题同特异性才能盖住）
// 首卡与内容顶部完全对齐，不留间距（首页 / 关于 / 标签 / 分类 / 归档等所有页面）
.posts-expand { padding-top: 0; }
.posts-expand .post-body p { margin: 0 0 10px 0; }
.posts-expand .post-meta { margin: 2px 0 22px 0; }
.post-button { margin-top: 24px; }

h1, h2, h3, h4, h5, h6 {
  margin: 14px 0 8px;
  line-height: 1.4;
}

// 6. 归档页：字号跟进正文，时间线换成主色系，整体左移收紧
.posts-collapse {
  margin-left: 24px;

  &::after { background: $timeline-tint; }

  .collection-title {
    margin: 32px 0;

    &::before { background: $custom-main-color; }
  }

  .post-title {
    font-size: 15px;

    a, span.exturl { color: $text-color; }
  }

  .post { margin: 18px 0; }

  .post-header {
    border-bottom: 1px dotted alpha($custom-main-color, 0.3);

    &::before {
      background: $custom-main-color;
      border-color: $custom-bg-color;
    }
  }
}

// 归档页顶部圆点：与年份 / 条目圆点同色，去掉半透明发灰
.page-archive .posts-collapse .archive-move-on {
  background: $custom-main-color;
  border-color: $custom-bg-color;
  opacity: 1;
}

// 8. 分页：当前页用主色实底白字，替掉主题默认的灰白色块
// 分页条是内容列最后一个元素，主题只给了上边距，补下边距避免与 footer 贴住
.pagination {
  margin-bottom: 20px;
}

.comments {
  margin-bottom: 20px;
}
.pagination .page-number.current {
  color: #fff;
  background: $custom-main-color;
  border-top-color: $custom-main-color;
}

.pagination .page-number:hover,
.pagination .prev:hover,
.pagination .next:hover {
  color: $custom-main-color;
}

// 9. 内容页标题下的主题灰白分割线换成主色系
.post-body h1,
.post-body h2,
.post-body h3,
.post-body h4 {
  border-bottom-color: alpha($custom-main-color, 0.3);
}

// 10. 右侧「文章目录 / 站点概览」面板：选中态压掉主题橙色，换成主色系
.sidebar-nav li:hover { color: $custom-main-color; }

.sidebar-nav .sidebar-nav-active,
.sidebar-nav .sidebar-nav-active:hover {
  color: $custom-main-color;
  border-bottom-color: $custom-main-color;
}

.post-toc .nav .active > a {
  color: $custom-main-color;
  border-bottom-color: $custom-main-color;
}

.post-toc .nav .active-current > a,
.post-toc .nav .active-current > a:hover {
  color: $custom-main-color;
}

// 11. 搜索弹窗：Solarized 米白底 + 暖沙头部 + 主色系点缀
.local-search-popup {
  background: $custom-bg-color;
  color: $text-color;

  .local-search-header { background: $menu-item-color; }

  .local-search-input-wrapper input { color: $text-color; }

  p.search-result { border-bottom: 1px dashed alpha($custom-main-color, 0.3); }

  .search-keyword {
    border-bottom: 1px dashed #dc322f;
    color: #dc322f;
  }

  a.search-result-title { color: $custom-main-color; }

  .search-icon, .popup-btn-close { color: $grey-dim; }

  .popup-btn-close {
    border-left: 1px solid alpha($custom-main-color, 0.25);

    &:hover { color: $custom-main-color; }
  }

  #no-result { color: $grey-dark; }
}

// 16. Windows 专属渲染补偿（已停用，2026-09）：
//     原先用 0.15px 同色发丝描边补 Palatino Linotype 在 ClearType 下的发浅。
//     但 text-stroke 作用于整个元素、无法按字符集分离，Windows 汉字改落微软雅黑后会被连带描粗。
//     现整体注释掉 —— Windows 不再加描边，恢复各自字体的原生观感。
//     若要重新启用，取消下面两段注释即可（豁免范围必须限定「真粗体」元素：
//     正文内章节标题、归档年份、代码块/行内码；卡片与大标题保留描边）。
// html.os-win body {
//   -webkit-text-stroke: 0.15px currentColor;
// }

// html.os-win .post-body h1,
// html.os-win .post-body h2,
// html.os-win .post-body h3,
// html.os-win .post-body h4,
// html.os-win .post-body h5,
// html.os-win .post-body h6,
// html.os-win .collection-title,
// html.os-win pre,
// html.os-win code,
// html.os-win kbd {
//   -webkit-text-stroke: 0;
// }

// 12. 全站灰白线整改：把主题残留的 #eee/#ddd/#ccc 边框统一换成主色系浅调
.post-nav {
  border-top-color: alpha($custom-main-color, 0.35);
}

.post-body blockquote {
  border-left-color: alpha($custom-main-color, 0.35);
}

.post-body th,
.post-body td {
  border-color: alpha($custom-main-color, 0.25);
}

// 表格配色 Solarized 化：主题硬编码的灰白斑马纹（#f9f9f9）、灰白 hover（#f5f5f5）
// 换成米白 / 暖沙交替（与侧栏激活菜单同色系）；thead 下沿 3px 分隔线改主色，
// 行背景挂在 tr 上，单元格半透明边框不会叠出双线
.post-body table {
  > thead > tr > th { border-bottom: 2px solid $custom-main-color; }

  > tbody > tr:nth-of-type(odd) { background-color: lighten($custom-bg-color, 1%); }

  > tbody > tr:hover {
    background-color: $menu-item-color;

    > td, > th { background-color: transparent; }
  }
}

.posts-expand .post-body img {
  border-color: alpha($custom-main-color, 0.25);
}

hr {
  background-color: alpha($custom-main-color, 0.35);
  background-image: repeating-linear-gradient(-45deg, $custom-bg-color, $custom-bg-color 4px, transparent 4px, transparent 8px);
}

.site-author-image {
  border-color: $menu-item-color;
}

.site-state-item {
  border-left-color: alpha($custom-main-color, 0.25);
}

.post-toc ol a {
  border-bottom-color: alpha($custom-main-color, 0.3);
}

.pagination .prev,
.pagination .next,
.pagination .page-number {
  border-top: none;
  border-bottom: none;
}

// 13. 橙色残留清理：移动端汉堡按钮线 + 文章内 tabs 插件的橙与灰白框
.page-post-detail .sidebar-toggle-line {
  background: $custom-main-color;
}

.post-body .tabs ul.nav-tabs li.tab.active {
  border-top-color: $custom-main-color;
  border-left-color: alpha($custom-main-color, 0.25);
  border-right-color: alpha($custom-main-color, 0.25);
  background-color: $custom-bg-color;

  +mobile-smallest() {
    border-top-color: alpha($custom-main-color, 0.25);
    border-left-color: $custom-main-color;
    border-bottom-color: alpha($custom-main-color, 0.25);
  }
}

.post-body .tabs .tab-content {
  background-color: $custom-bg-color;

  .tab-pane {
    border-color: alpha($custom-main-color, 0.25);
  }
}

// 14. 字体栈：以 CSS 变量 --font-serif 下发。
//     拉丁回退链：Palatino → Palatino Linotype → Georgia → 系统衬线。
//     Mac 命中 Palatino，Windows 命中系统 Palatino Linotype，其余环境落系统衬线。
//     不再挂任何拉丁 webfont（IBM Plex Serif 已移除），省掉它的请求与解析。
//     汉字不挂 webfont：Mac 命中 Songti SC；Windows 走苹方→微软雅黑，全区统一雅黑；
//     其余环境（如 Ubuntu）由系统默认中文衬线 Noto Serif CJK SC 兜底；
//     最后再挂 Noto Sans CJK SC（Android 自带的思源黑体），把 Android 原本靠浏览器
//     最后一层 fallback 的隐式命中变成显式命中，然后才是 serif 通用族。
//     已移除：STSong / SimSun（观感）/ Source Han Serif SC（装机率）/ Hiragino Sans GB；
//     Noto Serif SC 也移除——它在 Windows 上覆盖不全（Win10、英文版都没有），
//     留着只会让 Windows 读者之间字体不一致，不如统一雅黑。
//     Windows 专属调整经 head-unique.swig 的 UA 脚本挂 html.os-win 类实现，
//     后续任何仅针对 Windows 的样式 hack 都可挂在 html.os-win 下。
//     主题 font.family 机制会给整栈加引号失效，故直接在此定义；
//     webfont 链接在 head-unique.swig（同域自托管）；字重保持主题默认（大标题 400、章节标题 600）
$serif-stack = Palatino, "Palatino Linotype", Georgia, "Songti SC", "PingFang SC", "Microsoft YaHei", "Noto Serif CJK SC", "Noto Sans CJK SC", serif

:root { --font-serif: $serif-stack; }

body,
.post-body,
.posts-expand .post-meta,
h1, h2, h3, h4, h5, h6,
.site-title,
.site-subtitle {
  font-family: var(--font-serif);
}

// 表单控件默认不继承字体，显式跟上
.local-search-input-wrapper input,
.copy-btn {
  font-family: inherit;
}

// 行内码：拉丁/数字走等宽链（补 Ubuntu Mono 作 Linux 兜底），汉字回退正文宋体系。
// 栈尾收 monospace 而非 serif——这是等宽语境，之前的 serif 是遗留错误，会导致
// 所有具名字体缺失时 Latin 落系统衬线体（比例字形）出现在代码里。
// samp 一并纳入：主题 normalize 把 code/kbd/pre/samp 当作同一组设字体，
// 只覆盖其中三个会让 samp 留在 monospace,monospace 这套无关的栈里。
code, samp {
  font-family: "IBM Plex Mono", "SF Mono", Menlo, Consolas, "Ubuntu Mono", "Songti SC", "PingFang SC", "Microsoft YaHei", "Noto Serif CJK SC", "Noto Sans CJK SC", monospace;
}

// 代码块与 kbd：与行内码同栈（拉丁等宽 → 汉字宋体系 → monospace 兜底）。
// 汉字链必须排在拉丁链之后：中文字体自带拉丁字形，提前会把代码里的 Latin 接管成比例字形。
// `pre code` 是承重不是冗余：`<code>` 自身的声明优先于从 `<pre>` 继承的值，
// 靠它（0-0-2）压住行内码的 `code`（0-0-1），将来才能单独调代码块。别删。
pre, pre code, kbd {
  font-family: "IBM Plex Mono", "SF Mono", Menlo, Consolas, "Ubuntu Mono", "Songti SC", "PingFang SC", "Microsoft YaHei", "Noto Serif CJK SC", "Noto Sans CJK SC", monospace;
}

// 15. 代码块：字号与行距收紧，复制按钮 / 标题栏去灰白
.highlight,
.highlight pre,
pre {
  font-size: 12.5px;
  line-height: 1.5;
}

.highlight pre {
  padding: 8px 0;
}

// 15b. 代码块滚动条：浏览器原生滚动条是系统灰白条，与代码块底色（Solarized 米白 #fdf6e3）完全不搭。
//      轨道透明让底色透出来；滑块用暖沙（与全站填充色同源，≈ Solarized base2）——
//      先前用过冷调浅烟灰 #D8DFE1，在暖米白上发蓝发灰、跳出色系，故换暖沙，hover 加深一档。
//      一律实色，不用 rgba（半透明叠在米白上会透白显灰，已定规范）。
//      只写 ::-webkit-scrollbar（Chrome/Safari/Edge）；Firefox 一旦设 scrollbar-width/color
//      会反过来禁掉这套伪元素，所以不混写，Firefox 保留系统滚动条。
.highlight::-webkit-scrollbar,
pre::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

.highlight::-webkit-scrollbar-track,
pre::-webkit-scrollbar-track {
  background: transparent;
}

.highlight::-webkit-scrollbar-thumb,
pre::-webkit-scrollbar-thumb {
  background: #ECE7D5;
  border-radius: 4px;

  &:hover {
    background: #D8D2BC;
  }
}

.highlight::-webkit-scrollbar-corner,
pre::-webkit-scrollbar-corner {
  background: transparent;
}

.highlight figcaption {
  background: $menu-item-color;
  border-bottom-color: alpha($custom-main-color, 0.25);
}

.copy-btn {
  color: $custom-main-color;
  background-color: $menu-item-color;
  background-image: none;
  border-color: alpha($custom-main-color, 0.35);
  border-radius: 3px;

  &:hover {
    color: #fff;
    background-color: $custom-main-color;
    border-color: $custom-main-color;
  }
}
